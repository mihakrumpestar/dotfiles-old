#
# ~/.profile
#

# Env
# export LC_ALL="en_US.UTF-8"

# Locale
[ -f "$HOME/.config/locale.conf" ] && . "$HOME/.config/locale.conf"

# Devbox
# $DEVBOX_PACKAGES_DIR is not available at this time
export XDG_DATA_DIRS="$HOME/.local/share/devbox/global/default/.devbox/nix/profile/default/share:$XDG_DATA_DIRS"

# SSH agent
export SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/ssh-agent.socket
/usr/bin/ssh-agent -a $SSH_AUTH_SOCK # Start ssh agent (done here, as it does not work when started with SystemD)
export SSH_ASKPASS="/usr/local/bin/ksshaskpass" # TODO: make it work properly
export SSH_ASKPASS_REQUIRE=prefer

# PATH
if [ -d "$HOME/.bin" ]; then
    export PATH="$HOME/.bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Go
if [ -d "$HOME/go" ]; then
  export GOPATH=$HOME/go
  export PATH="$GOROOT/bin:$GOPATH/bin:$PATH"
fi
