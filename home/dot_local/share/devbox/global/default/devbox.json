    "hack-font":                         "latest",
    "liberation_ttf":                    "latest",
    "roboto":                            "latest",
    "roboto-mono":                       "latest",
    "ubuntu_font_family":                "latest",
    "fira-code":                         "latest",
    "fira-code-symbols":                 "latest",
