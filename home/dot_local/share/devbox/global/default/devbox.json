    "gcolor3":    "latest",
    "gimp":       "latest", // Alternative is: https://github.com/PintaProject/Pinta
    "inkscape":   "latest",
    "upscayl":    "latest", // Image upscaler

    // Apps
    "xournalpp":        "latest", // Draving software
    "kate":             "latest", // General GUI text editor
    "evince":           "latest", // Document viewer (PDF)
