// devbox global path

{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": {
    // Terminal
    "nano":     "latest",
    "curl":     "latest",
    "wget":     "latest",
    "onefetch": "latest", // neofetch for Git
    "fastfetch": "latest", // System info, the new neofetch
    "ipfetch": "latest", // Neofetch for IPs
    "btop": "latest", // better htop
    "starship": "latest", // terminal UI
    "zoxide": "latest", // Better cd
    "bash":                 "latest",
    "bash-completion":      "latest",
    "nix-bash-completions": "latest",
    "bat":                  "latest", // Better cat
    "sops":      "latest",
    "tree":      "latest",
    "multitail": "latest", // File viewer
    "fzf": "latest", // Command-line fuzzy finder
    "kitty": "latest", // Terminal emulator
    "yakuake": "latest", // Drop down terminal emulator
    "zellij": "latest", // Modern Tmux (terminal multiplexer)
    "pciutils": "latest", // Computer utility info
    "usbutils": "latest", // USB utility info
    "udisks2": "latest", // Command is udisksctl
    "udiskie": "latest", // A user-level daemon for auto-mounting
    "python312Packages.sparklines": "latest",
    "lolcat":                       "latest",
    
    // Fonts
    "meslo-lgs-nf": "latest", // font for starship
    //ttf-ms-fonts
    "SDL2_ttf":     "latest",
    "carlito":      "latest",
    "dejavu_fonts": "latest",
    //ttf-droid
    "font-awesome":       "latest",
    "hack-font":          "latest",
    "liberation_ttf":     "latest",
    "roboto":             "latest",
    "roboto-mono":        "latest",
    "ubuntu_font_family": "latest",
