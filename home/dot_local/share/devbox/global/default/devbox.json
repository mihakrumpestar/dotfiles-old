    //noto-fonts-emoji
    //adobe-source-code-pro-fonts
    //adobe-source-han-sans-kr-fonts
    //adobe-source-han-sans-cn-fonts
    //adobe-source-han-sans-jp-fonts
    //adobe-source-sans-fonts
    //awesome-terminal-fonts
    //xorg-fonts-encodings
    //cantarell-fonts

    // Video/Audio and photo
    "vlc": "latest", // Media Player
    "handbrake":  "latest",
    "obs-studio": "latest",
    "gcolor3":    "latest",
    "gimp":       "latest",
    // Alternative is: https://github.com/PintaProject/Pinta
    "inkscape": "latest",
    "upscayl":  "latest", // Image upscaler

    // Apps
    "xournalpp": "latest", // Draving software
    "kate": "latest", // General GUI text editor
    "evince": "latest", // Document viewer (PDF)
    //masterpdfeditor4      // PDF editor (non-free license)
    //texlivePackages.latex  //texlive-latex       // For xournalpp Latex
    //texlivePackages.collection-latexextra //texlive-latexextra  // For xournalpp Latex
    "zoom": "latest",
    //nomachine
    //"freetube@latest", // Youtube client (insecure electron version)
    "pika-backup": "latest", // Backup tool (automatic) TODO: replace

    // Office Suite
    "libreoffice-fresh": "latest",
    "onlyoffice-bin":    "latest",
    
    // Browsers
    "brave":     "latest",
    "librewolf": "latest",
    //thorium-browser-bin

    // File Management
    "okular": "latest", // PDF viewer
    "zip": "latest", // Zip files
    "ark": "latest", // GUI to compress or uncompress data
    "nextcloud-client": "latest",
    
    // Email
    "betterbird": "latest",
    "birdtray":   "latest",
    
    // Programming
    "git":     "latest",
    "lazygit": "latest", // Git terminal UI
    "pre-commit": "latest", // Pre-commit hooks for Git
    "gnumake": "latest", // make
    "python3": "latest", //python-pip
    "go":     "latest",
    "nodejs": "latest", // npm
    "vscodium": "latest", // Main code editor
    "bruno":    "latest",
    "chezmoi":  "latest",
    "gitleaks": "latest", // Check for leaks in git repos, scans all branches with all commit history
    //terraform            // (non-free license)
    "pyinfra": "latest", // The new Ansible

    // Formatters
    //prettier

    // Linters
    "hadolint": "latest",
    // Used in VSCodium
    //python-pylint   // Used in VSCodium

    // Tools
    "gsmartcontrol": "latest",
    //"gnome-disk-utility@latest", // (dep errors)
    "ventoy": "latest",
    //popsicle-bin
    "android-tools":               "latest",
    "universal-android-debloater": "latest", // CLI: uad-ng
    //distrobox          // Run any distribution on any Linux
    ////xorg-xhost         // xhost, dependency for prev
    "audacity": "latest", // Sound
    "corectrl": "latest",  // GPU and CPU guvernor

    //"activitywatch@latest", // Time monitoring (fails to build)
    "apacheHttpd": "latest", // for htpasswd
    //superpaper         // Wallpaper
    "stacer": "latest", // System monitoring GUI
    //appimagelauncher    // AUR, integrate appimages as apps, works after reboot
    "rclone": "latest",
    "whois":  "latest", // Contains mkpasswd
    "filezilla": "latest",
    "droidcam":  "latest", // Webcam emulator from Android
    "lazydocker": "latest", // Docker container management, Portainer alternative
    "gomplate": "latest", // Templating cli
    "gnutar": "latest", // tar
    "trash-cli": "latest", // Command line trashcan (recycle bin) interface
    "meld": "latest", // Compare files
    "chafa": "latest", // ASCII art
    "speedtest-go": "latest", // Internet speedtest in CLI
    "drawio": "latest", // Drawing tool
    "kcalc": "latest", // Calculator
    "flameshot": "latest", // alt: satty       // Screenshot tool
    "rofi-wayland": "latest", // Rofi with Wayland support

    // Desktop environment
    "copyq": "latest",
    // clipboard manager

    // Security
    "keepassxc":   "latest",
    "onlykey":                  "latest",
    "onlykey-cli": "latest",
    "openssh": "latest", // ssh-agent
    "ksshaskpass": "latest", // Before gnome-ssh-askpass4-git

    // Containers
    "podman":         "latest",
    "docker":         "latest",
    "docker-compose": "latest",
    
    // QEMU
    //   qemu_full // TODO: won't build
    "virt-manager": "latest",
    
    // Printer and scanner
    "simple-scan": "latest",
    // Scanning (Gnome)
    "cups":         "latest",
    "hplip":        "latest",
    "sane-airscan": "latest",
    "avahi":        "latest", // Network scanning (printer and scanner)

    // System
    "ntp": "latest", // time
    "nftables": "latest", // firewall
    "iptables-nftables-compat": "latest", // iptables to nftables layer, required for Docker
    "glxinfo":          "latest",
    "stdenv.cc.cc.lib": "",
    "libglvnd":         "latest",
    "mesa": {
      "version": "24.1.4", // latest is too old
      "outputs": ["drivers"],
    },
    "gnome-tweaks":             "latest",
    "Vorta":                    "latest",
    "gnome.adwaita-icon-theme": "latest",
    "hicolor-icon-theme":       "latest",
    "vanilla-dmz":              "latest",
  },
  "env": {
    //"LD_LIBRARY_PATH": "$DEVBOX_PACKAGES_DIR/lib" // If this is set GlibC dep in devbox itself is wrongly detected, does not override the default one (hardcoded by NixOS)
  },
  "shell": {
    "init_hook": ["echo 'Welcome to devbox!' > /dev/null"],
    "scripts": {
      "test": ["echo \"Error: no test specified\" && exit 1"],
    },
  },
}
