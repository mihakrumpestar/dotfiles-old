    "apacheHttpd": "latest", // for htpasswd
    "stacer":       "latest", // System monitoring GUI
    "rclone":       "latest",
    "whois":        "latest", // Contains mkpasswd
    "filezilla":    "latest",
    "droidcam":     "latest", // Webcam emulator from Android
    "lazydocker":   "latest", // Docker container management, Portainer alternative
    "gomplate":     "latest", // Templating cli
    "gnutar":       "latest", // tar
    "trash-cli":    "latest", // Command line trashcan (recycle bin) interface
    "meld":         "latest", // Compare files
    "chafa":        "latest", // ASCII art
    "speedtest-go": "latest", // Internet speedtest in CLI
    "drawio":       "latest", // Drawing tool
    "kcalc":        "latest", // Calculator
    "flameshot":    "latest", // alt: satty       // Screenshot tool
    "rofi-wayland": "latest", // Rofi with Wayland support (TODO: fails to start)
    "rymdport":     "latest", // Wormhole client
    "unzip":        "latest",
    "variety":      "latest", // Wallpaper manager, alternative is superpaper

    // Desktop environment
    "copyq":          "latest", // clipboard manager
    "kdeconnect-kde": "latest",

    // Security
    "keepassxc":   "latest",
    "onlykey-cli": "latest", // Onlykey app installed from source
    "openssh":     "latest", // ssh-agent
    "ksshaskpass": "latest", // Before: gnome-ssh-askpass4-git TODO: not working

    // Containers
    "podman":         "latest",
    "podman-compose": "latest",
    "podman-desktop": "latest", // TODO: not working // We are not using docker as it does not work on non-NixOS distibutions as per https://nixos.wiki/wiki/Docker
    "nomad":          "latest",
    "nomad-driver-podman": "latest",

    // QEMU
    //   qemu_full // TODO: won't build
    //"virt-manager": "latest",

    // Printer and scanner
    "simple-scan": "latest", // Scanning (Gnome)

    // System
    "ntp":      "latest", // time
    "nftables": "latest", // firewall
    //"texlive.combined.scheme-full": "latest", // Add only when needed; Containes pdflatexa and Tex packages required by xournalpp (full is the minimum req to run)

    // Drivers
    "stdenv.cc.cc.lib": "",
    "libglvnd":         "latest",
    "mesa": { // Main GPU drivers
      "version": "24.1.5", // latest is too old
      "outputs": ["drivers"],
    },
    "amdvlk":                   "latest", // AMD Vulkan drivers
    "vulkan-utils":             "latest", // Verify with CMD: vulkaninfo
    "vulkan-loader":            "latest",
    "vulkan-validation-layers": "latest",
    "vulkan-extension-layer":   "latest",
    "rocmPackages.clr.icd":     "", // OpenCL drivers
    
    // Flakes
    "path:./virtualhere-client": "",
    "path:./activitywatch": "",
  },
  "env": {
    //"LD_LIBRARY_PATH": "$DEVBOX_PACKAGES_DIR/lib" // If this is set GlibC dep in devbox itself is wrongly detected, does not override the default one (hardcoded by NixOS)
  },
  "shell": {
    "init_hook": ["echo 'Welcome to devbox!' > /dev/null"],
    "scripts": {
      "test": ["echo \"Error: no test specified\" && exit 1"],
    },
  },
}

