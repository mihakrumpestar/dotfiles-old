// devbox global path

{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": {
    // Terminal
    "nano":                 "latest",
    "curl":                 "latest",
    "wget":                 "latest",
    "onefetch":             "latest", // neofetch for Git
    "fastfetch":            "latest", // System info, the new neofetch
    "ipfetch":              "latest", // Neofetch for IPs
    "btop":                 "latest", // better htop
    "starship":             "latest", // terminal UI
    "zoxide":               "latest", // Better cd
    "bash":                 "latest",
    "zsh":                  "latest",
    "fish":                 "latest",
    "bat":                  "latest", // Better cat
    "sops":                 "latest",
    "less":                 "latest",
    "tree":                 "latest",
    "fzf":                  "latest", // Command-line fuzzy finder/search
    "kitty":                "latest", // Terminal emulator
    "guake":                "latest", // Drop down terminal emulator
    "zellij":               "latest", // Modern Tmux (terminal multiplexer)
    "pciutils":             "latest", // Computer utility info
