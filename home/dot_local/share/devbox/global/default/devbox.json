    "freetube":    "latest", // Youtube client
    "pika-backup": "latest", // Backup tool (automatic) TODO: replace

    // Office Suite
    "libreoffice-fresh": "latest",
    "onlyoffice-bin":    "latest",

    // Browsers
    "brave":     "latest",
    "librewolf": "129.0-1",
    //thorium-browser-bin

    // File Management
    "okular":           "latest", // PDF viewer
    "zip":              "latest", // Zip files
    "ark":              "latest", // GUI to compress or uncompress data
    "nextcloud-client": "latest",

    // Email
    "betterbird": "115.6.0",
    "birdtray":   "latest",

    // Programming
    "git":        "latest",
    "git-filter-repo": "latest",
    "lazygit":    "latest", // Git terminal UI
    "pre-commit": "latest", // Pre-commit hooks for Git
    "gnumake":    "latest", // make
    "python3":    "latest", //python-pip
    "go":         "latest",
    "nodejs":     "latest", // npm
    "vscodium":   "latest", // Main code editor ("vscodium-fhs" package has its own FHS, where you would have to install all packages additionaly in it to be able to use them, as it won't take the system ones)
    "bruno":      "latest",
    "chezmoi":    "latest",
    "go-task":    "latest",
    "gitleaks":   "latest", // Check for leaks in git repos, scans all branches with all commit history
    "terraform":  "latest",
    "pyinfra":    "latest", // The new Ansible
    "gh":         "latest",
    "nilaway":    "latest",
    "infisical":  "latest",

    // Formatters
    "nodePackages.prettier": "latest",

