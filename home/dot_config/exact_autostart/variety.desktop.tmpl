#!/usr/bin/env xdg-open
[Desktop Entry]variety.desktop
Name=Variety
Comment=Variety Wallpaper Changer
Categories=GNOME;GTK;Utility;
Exec=variety --set={{ .chezmoi.homeDir }}/wallpapers/nebula-8k-wallpaper.jpg # variety %U
MimeType=text/uri-list;x-scheme-handler/variety;x-scheme-handler/vrty;
Icon=variety
Terminal=false
Type=Application

X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
X-KDE-autostart-after=panel
X-LXQt-Need-Tray=true