// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/Documents/wallpapers-and-avatars/nebula-8k-wallpaper.jpg",
    "type": "chafa",
    "width": 50,
    //"height": 25,
    "preserveAspectRatio": true,
    "padding": {
      "left": 4,
      "top": 5, // 2
      "right": 4
    }
  },
  "display": {
    "showErrors": true,
    "separator": ": "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────────────────────────────────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠",
      "format": "{1} ({3}/{4})",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛",
      "format": "{1} {2}",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰑭",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└ └",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    //{ // Currently not working, segmentation fault
    //  "type": "bootmgr",
    //  "key": "│ ├",
    //  "keyColor": "yellow"
    //},
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "└ └",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "de", // wm
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "└ └",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────────────────────────────────────────┐"
    },
    {
      "type": "command",
      "key": "󱑎 AGE",
      "text": "install_time=$(stat -c %W /); if [ \"$install_time\" -eq 0 ]; then install_time=$(stat -c %Y /); fi; os_age_days=$(( ( $(date +%s) - install_time ) / 86400 )); y=$(( os_age_days / 365 )); m=$(( (os_age_days % 365) / 30 )); d=$(( (os_age_days % 365) % 30 )); output=\"\"; if [ $y -gt 0 ]; then output=\"${y} years, \"; fi; if [ $m -gt 0 ]; then output=\"${output}${m} months, \"; fi; if [ $d -gt 0 ]; then output=\"${output}${d} days\"; fi; output=$(echo $output | sed 's/ $//'); if [ -z \"$output\" ]; then echo \"0 days\"; else echo \"$output\"; fi",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "└ └─󰭗",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
