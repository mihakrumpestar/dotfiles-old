{
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'Droid Sans Mono', monospace, 'MesloLGS NF'",
  "vsicons.dontShowNewVersionMessage": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "remote.SSH.defaultExtensions": [
    "ms-azuretools.vscode-docker",
    "matthewpi.caddyfile-support",
    "bungcip.better-toml",
    "tumido.cron-explained",
    "earthly.earthfile-syntax-highlighting",
    "dsznajder.es7-react-js-snippets",
    "dbaeumer.vscode-eslint",
    "tamasfe.even-better-toml",
    "eamodio.gitlens",
    "golang.go",
    "ecmel.vscode-html-css",
    "ms-vscode.makefile-tools",
    "DavidAnson.vscode-markdownlint",
    "jock.svg",
    "bradlc.vscode-tailwindcss",
    "Gruntfuggly.todo-tree",
    "tomoki1207.pdf"
  ],
  "files.associations": {
    "*.enc*": "ini",
    "*.env*": "ini",
    "*.arg": "ini"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "diffEditor.ignoreTrimWhitespace": false,
  "go.survey.prompt": false,
  "redhat.telemetry.enabled": false,
  "languageToolLinter.languageTool.language": "en-US",
  "languageToolLinter.lintOnOpen": true,
  "languageToolLinter.serviceType": "public",
  "languageToolLinter.languageTool.ignoredWordsGlobal": [
    "addons",
    "barebones",
    "bitwarden",
    "canvasblocker",
    "capatcha",
    "dalvik",
    "databackup",
    "dotbot",
    "dotfile",
    "dotfiles",
    "emqx",
    "fastboot",
    "flagfox",
    "foldersync",
    "gapps",
    "iceraven",
    "infisical",
    "kernelsu",
    "ock-or",
    "pve",
    "rclone",
    "spectre",
    "systemd",
    "tabliss",
    "tasklify",
    "ublock-origin",
    "virtualhere",
    "webview",
    "winget",
    "winutil",
    "xdaforums",
    "yadm"
  ],
  "languageToolLinter.plainText.languageIds": ["markdown"],
  "workbench.panel.defaultLocation": "right",
  "pylint.args": [
    "--disable=unexpected-keyword-arg",
    "--disable=missing-module-docstring"
  ],
  "go.toolsManagement.autoUpdate": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "cSpell.userWords": [
    "automations",
    "buildx",
    "caarlos",
    "chromahtml",
    "cmds",
    "findbar",
    "godoc",
    "gofakeit",
    "GOMPLATE",
    "gookit",
    "goutil",
    "Infisical",
    "Koncno",
    "mpga",
    "mtask",
    "Nextcloud",
    "noconfirm",
    "ogleda",
    "OPENAI",
    "pdfs",
    "podpis",
    "porocilo",
    "priloge",
    "Taskfile",
    "templating",
    "tmpl",
    "urlbar",
    "WEBDAV",
    "webm",
    "weightedrand",
    "Zapisi",
    "zdruzeno",
    "zerolog",
    "zvocni"
  ],
  "markdown-preview-enhanced.enableExtendedTableSyntax": true,
  "markdown-preview-enhanced.HTML5EmbedUseLinkSyntax": true,
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "cSpell.enableFiletypes": ["!yaml"],
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  }
}
