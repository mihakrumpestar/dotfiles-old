{
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'Droid Sans Mono', monospace, 'MesloLGS NF'",
  "vsicons.dontShowNewVersionMessage": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "remote.SSH.defaultExtensions": [
    "ms-azuretools.vscode-docker"
  ],
  "files.associations": {
    "*.enc*": "ini",
    "*.env*": "ini",
    "*.arg": "ini",
    "devbox.json": "jsonc",
    "*.desktop*": "ini",
    "*.service": "ini"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "go.survey.prompt": false,
  "redhat.telemetry.enabled": false,
  "languageToolLinter.languageTool.language": "en-US",
  "languageToolLinter.lintOnOpen": true,
  "languageToolLinter.serviceType": "public",
  "languageToolLinter.plainText.languageIds": [
    "markdown"
  ],
  "workbench.panel.defaultLocation": "right",
  "pylint.args": [
    "--disable=unexpected-keyword-arg",
    "--disable=missing-module-docstring"
  ],
  "go.toolsManagement.autoUpdate": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "cSpell.enableFiletypes": [
    "!jsonc",
    "!yaml"
  ],
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "notebook.lineNumbers": "on",
  "hediet.vscode-drawio.theme": "Kennedy",
  "hediet.vscode-drawio.defaultVertexStyle": {
    "fontSize": 16
  },
  "hediet.vscode-drawio.defaultEdgeStyle": {
    "fontSize": 16
  },
  "markdown-preview-enhanced.enableExtendedTableSyntax": true,
  "markdown-preview-enhanced.HTML5EmbedUseLinkSyntax": true,
  "markdown-preview-enhanced.previewTheme": "github-light.css",
  "markdown-preview-enhanced.markdownFileExtensions": [
    ".md",
    ".markdown",
    ".mdown",
    ".mkdn",
    ".mkd",
    ".rmd",
    ".qmd"
  ],
  "markdown-preview-enhanced.hideDefaultVSCodeMarkdownPreviewButtons": false,
  "markdown-preview-github-styles.colorTheme": "light",
  "svg.preview.mode": "svg",
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,qmd}",
    "!**/.quarto",
    "!**/.temp",
    "!**/.tmp",
    "!**/assets"
  ],
  "markdownlint.run": "onSave",
  // Language specific settings
  "[quarto]": {
    "editor.defaultFormatter": "quarto.quarto",
    "editor.tabSize": 3,
    "editor.insertSpaces": true
  },
  "terminal.external.linuxExec": "kitty",
  "window.zoomLevel": 0.4,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "json.format.enable": false
}