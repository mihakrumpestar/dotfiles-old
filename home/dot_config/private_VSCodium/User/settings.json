{
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'Droid Sans Mono', monospace, Helvetica, 'MesloLGS NF'",
  "vsicons.dontShowNewVersionMessage": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "remote.SSH.defaultExtensions": ["ms-azuretools.vscode-docker"],
  "files.associations": {
    "*.enc*": "ini",
    "*.env*": "ini",
    "*.arg": "ini"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "diffEditor.ignoreTrimWhitespace": false,
  "go.survey.prompt": false,
  "redhat.telemetry.enabled": false,
  "languageToolLinter.languageTool.language": "en-US",
  "languageToolLinter.lintOnOpen": true,
  "languageToolLinter.serviceType": "public",
  "languageToolLinter.languageTool.ignoredWordsGlobal": [
    "addons",
    "android-usb-gadget",
    "android-usb-script",
    "barebones",
    "bitwarden",
    "blendos",
    "canvasblocker",
    "capatcha",
    "dalvik",
    "databackup",
    "dotbot",
    "dotfile",
